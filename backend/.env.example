# ==========================================
# Shelflick Backend Environment Configuration
# ==========================================

# Project & Environment
PROJECT_NAME="Shelflick"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="production" # Options: development, staging, production, test
DEBUG=False

# Database Configuration (PostgreSQL with asyncpg driver)
# Cloud Example (Supabase/Neon/RDS): postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mediapulse"

# CORS & Frontend Origins
# In production, set your live frontend URL (e.g. Vercel, Netlify, Custom Domain)
FRONTEND_URL="https://shelflick.vercel.app"
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://shelflick.vercel.app"]

# JWT Authentication & Security
JWT_SECRET_KEY="replace-with-a-secure-random-64-character-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 Days

# Google OAuth2 Authentication (Optional)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# External Media APIs
TMDB_API_KEY="your-tmdb-v3-api-key"
TMDB_ACCESS_TOKEN="your-tmdb-v4-read-access-token"
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p/w500"
IMAGE_PROXY_BASE_URL="http://localhost:8000/api/v1/proxy/image"
ANILIST_GRAPHQL_URL="https://graphql.anilist.co"

# AI & LLM Engine Configuration
LLM_PROVIDER="gemini" # Options: gemini, openai
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE=0.2

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False
