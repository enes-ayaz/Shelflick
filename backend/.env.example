# MediaPulse Application Configuration
PROJECT_NAME="MediaPulse"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/mediapulse"

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False
